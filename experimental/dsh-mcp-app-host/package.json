{
  "name": "dsh-f24-mcp-app-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./saved": "./lib/saved.js"
  },
  "files": [
    "lib"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node tests/host-integration.mjs",
    "test:dsh": "node tests/dsh-host.mjs",
    "test:saved-dsh": "node tests/dsh-saved-host.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "zod": "4.2.0",
    "@modelcontextprotocol/server": "2.0.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  },
  "peerDependencies": {
    "react": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
